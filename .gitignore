# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# IDE
.idea/

# Logs
logs/
log/
*.log

# Local secrets / environment-specific config
# conf/app_config.yaml 含数据库口令与 LLM API Key, 不进入版本库;
# 用 conf/app_config.example.yaml 作为模板。
# 注意: conf/meta_config.yaml 只有数仓表/字段/指标的语义描述, 不含任何凭据,
# 且是构建元知识库的必要输入, 因此保留在版本库中跟踪。
conf/app_config.yaml

# 本地启动脚本（内含 LLM_API_KEY 等凭据），绝不入库
start.ps1
start.sh
# 评测脚本会注入本机数据库口令，同样不入库；
# 模板见 finetune/run_eval_all.example.ps1，真实口令用环境变量传。
finetune/run_eval_all.ps1
.env
.env.*

# 一次性调试脚本（下划线开头），不入库
_*.py
_*.txt
_*.jsonl

# 测量 token 长度用的 Qwen tokenizer 缓存（从 ModelScope 下的，可随时重下）
finetune/data/_qwen_tok/
